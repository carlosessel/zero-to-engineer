---
import Page from '../layouts/Page.astro';
import { getCourses, href } from '../lib/load';
const courses = await getCourses();
const blurb: Record<string, string> = {
  ai: 'From your first line of Python to building, testing and shipping products on top of language models. The maths is taught from arithmetic.',
  se: 'From how a computer works to building, testing, deploying and running real software with other people.',
};
---
<Page title="Zero to Engineer" heading="Zero to Engineer" description="Two free courses that start from nothing: Zero to AI Engineer and Zero to Software Engineer.">
    <p class="lead">Two free courses that assume you know nothing about programming. They share their beginner chapters, so starting one gives you a head start on the other.</p>
    <div class="cards">
      {courses.map((c) => (
        <section class="card">
          <h2><a href={href(`/${c.id}/`)}>{c.title}</a></h2>
          <p>{blurb[c.id]}</p>
          <p class="hint">{c.chapters.length} chapters in {c.parts.length} parts</p>
          <div class="meter" data-meter={c.chapters.map((x) => x.id).join(' ')}><div class="bar"><i></i></div><span></span></div>
          <p><a class="btn" href={href(`/${c.id}/`)}>Open the course</a></p>
        </section>
      ))}
    </div>
    <div class="note">
      <p><strong>This site is being built in the open and is not finished.</strong> Every chapter shows its own status. At the moment the chapters are short first drafts moved over from a prototype: the code in them has not yet been run under test, the contents of the linked resources have not been reviewed, and no subject expert has reviewed them.</p>
    </div>
    <h2>Study tools</h2>
    <ul>
      <li><a href={href('/review/')}>Review</a>: quiz questions you got wrong come back, spaced out over days and weeks.</li>
      <li><a href={href('/planner/')}>Study planner</a>: enter your hours a week and get a schedule.</li>
      <li><a href={href('/search/')}>Search</a> every chapter, and the <a href={href('/glossary/')}>glossary</a> of every term.</li>
      <li><a href={href('/progress/')}>Save or restore your progress</a> as a file.</li>
    </ul>
</Page>
