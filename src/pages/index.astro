---
import Page from '../layouts/Page.astro';
import { getCourses, href } from '../lib/load';
const courses = await getCourses();
---
<Page title="Zero to Engineer" heading="Zero to Engineer" description={`Free courses that start from nothing: ${courses.map((c) => c.title).join(', ')}.`}>
    <p class="lead">Free courses that assume you know nothing to begin with. Courses share their beginner chapters, so starting one gives you a head start on the others.</p>
    <div class="cards">
      {courses.map((c) => (
        <section class="card">
          <h2><a href={href(`/${c.id}/`)}>{c.title}</a></h2>
          <p>{c.description}</p>
          <p class="hint">{c.chapters.length} chapters in {c.parts.length} parts</p>
          <div class="meter" data-meter={c.chapters.map((x) => x.id).join(' ')}><div class="bar"><i></i></div><span></span></div>
          <p><a class="btn" href={href(`/${c.id}/`)}>Open the course</a></p>
        </section>
      ))}
    </div>
    <div class="note">
      <p><strong>This site is being built in the open and is not finished.</strong> Every chapter shows its own status. Many chapters are still short first drafts moved over from a prototype. The code examples are run under automatic tests, but the contents of the linked resources have not all been reviewed, and no subject expert has reviewed the chapters.</p>
    </div>
    <h2>Study tools</h2>
    <ul>
      <li><a href={href('/review/')}>Review</a>: quiz questions you got wrong come back, spaced out over days and weeks.</li>
      <li><a href={href('/planner/')}>Study planner</a>: enter your hours a week and get a schedule.</li>
      <li><a href={href('/search/')}>Search</a> every chapter, and the <a href={href('/glossary/')}>glossary</a> of every term.</li>
      <li><a href={href('/progress/')}>Save or restore your progress</a> as a file.</li>
    </ul>
</Page>
