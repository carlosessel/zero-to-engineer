---
// A worked answer hidden until the learner chooses to see it.
// Usage in a chapter (leave blank lines inside so Markdown works):
//   <Solution>
//
//   The answer, with working.
//
//   </Solution>
interface Props { label?: string }
const { label = 'Show the solution' } = Astro.props;
---
<details class="solution"><summary>{label}</summary><div class="solution-body"><slot /></div></details>
