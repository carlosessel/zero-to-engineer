---
// The player's level, points and streak, shown in the header. Filled in by scripts/game.ts.
import { href } from '../lib/load';
---
<div class="chips">
  <a class="chip lvl" href={href('/achievements/')} title="Your level">Lv <span data-g="level">1</span></a>
  <a class="chip pts" href={href('/achievements/')} title="Your points"><span class="ico" aria-hidden="true">✦</span><span data-g="points">0</span><span class="tick"> points</span></a>
  <a class="chip streak" href={href('/achievements/')} title="Days in a row"><span class="ico" aria-hidden="true">🔥</span><span data-g="streak">0</span><span class="tick">-day streak</span></a>
</div>
