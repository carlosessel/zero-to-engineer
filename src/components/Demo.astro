---
// An interactive demo. Markup lives in src/demos/html/<name>.html and the
// behaviour in src/demos/demos.js (both ported from the prototypes).
interface Props { name: string }
const { name } = Astro.props;
const all = import.meta.glob('../demos/html/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const html = all[`../demos/html/${name}.html`];
if (!html) throw new Error(`No demo called "${name}" in src/demos/html.`);
---
<Fragment set:html={html} />
<noscript><p class="note">This demo needs JavaScript switched on.</p></noscript>
<script>
  import { initDemos } from '../demos/demos.js';
  initDemos();
</script>
