---
import { getCourses, href } from '../lib/load';
const courses = await getCourses();
---
<nav class="sitenav" aria-label="Site">
  <a href={href('/')}>Home</a>
  {courses.map((c) => <a href={href(`/${c.id}/`)}>{c.title}</a>)}
  <a href={href('/review/')}>Review<span data-review-count></span></a>
  <a href={href('/planner/')}>Planner</a>
  <a href={href('/search/')}>Search</a>
  <a href={href('/glossary/')}>Glossary</a>
  <a href={href('/progress/')}>Progress</a>
  <button class="btn ghost" type="button" data-theme-toggle>Theme: auto</button>
</nav>
